  "title":"Machine Read Notes untrusted source receipt v1",
  "type":"object","required":["schema","receipt_id","source_proof","url","publisher_name","project_refs","association_basis","event_type","published_at","rights_basis","review_state","binding_state"],
  "properties":{
    "schema":{"const":"globalgrid2050.source-receipt.v1"},"receipt_id":{"type":"string","minLength":1},"source_proof":{"enum":["SYNTHETIC FIXTURE — NOT AN ACTUAL ARTICLE","COLLECTED — AUTHENTICITY NOT INDEPENDENTLY VERIFIED"]},"url":{"type":"string","pattern":"^https://"},"canonical_url":{"type":["string","null"]},"publisher_name":{"type":"string","minLength":1},"publisher_owner_id":{"type":["string","null"]},"owner_verified":{"type":"boolean"},"rights_basis":{"enum":["unknown","permission_verified","public_domain_verified"]},"rights_proof_sha256":{"type":["string","null"]},"review_state":{"enum":["machine_only","human_review_pending","human_reviewed"]},"binding_state":{"const":"candidate"},"published_at":{"$ref":"#/$defs/clock"},"event_date":{"$ref":"#/$defs/nullableClock"},"fetched_at":{"$ref":"#/$defs/nullableClock"},"first_seen_at":{"$ref":"#/$defs/nullableClock"},"http_status":{"type":["integer","null"]},"content_type":{"type":["string","null"]},"retrieval_log":{"type":["string","null"]},"raw_bytes_sha256":{"type":["string","null"]},"capture_bytes_base64":{"type":["string","null"]},"project_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"project_name":{"type":["string","null"]},"named_project_refs":{"type":"array","items":{"type":"string"}},"association_basis":{"enum":["planning_reference","explicit_project_name","project_name_plus_location","project_name_plus_developer","multi_project_explicit","tie_break_only","unknown"]},"planning_reference":{"type":["string","null"]},"event_type":{"enum":["planning_application","consent_granted","consent_refused","construction_started","turbine_installation_started","financial_close","ownership_change","other"]},"event_reference":{"type":["string","null"]},"title":{"type":["string","null"]},"redirect_chain":{"type":"array","items":{"type":"string"}}
  },
